krome_format 1
# converted from legacy network 'react_primordial_photo' by convert_legacy.py

# legacy shortcut symbols, now ordinary vars:
var Te       = Tgas_eV
var lnTe     = log(Tgas_eV)
var invTe    = 1.0/Tgas_eV
var invT     = 1.0/Tgas
var sqrTgas  = sqrt(Tgas)
var T32      = Tgas/300.0

####################
#primordial rates including photoreactions from several authors (see Grassi et al. 2014)
H + e- -> H+ + e- + e-      [10, 1e8]      exp(-32.71396786e0+13.5365560e0*lnTe-5.73932875e0*(lnTe**2)+1.56315498e0*(lnTe**3)-0.28770560e0*(lnTe**4)+3.48255977e-2*(lnTe**5)-2.63197617e-3*(lnTe**6)+1.11954395e-4*(lnTe**7)-2.03914985e-6*(lnTe**8))

H+ + e- -> H                [10, 5.5e3]    3.92e-13*invTe**0.6353e0

H+ + e- -> H                [5.5e3, 1e8]   exp(-28.61303380689232e0-0.7241125657826851e0*lnTe-0.02026044731984691e0*lnTe**2-0.002380861877349834e0*lnTe**3-0.0003212605213188796e0*lnTe**4-0.00001421502914054107e0*lnTe**5+4.989108920299513e-6*lnTe**6+5.755614137575758e-7*lnTe**7-1.856767039775261e-8*lnTe**8-3.071135243196595e-9*lnTe**9)

He + e- -> He+ + e- + e-    [9.28e3, 1e8]  exp(-44.09864886e0+23.91596563e0*lnTe-10.7532302e0*(lnTe**2)+3.05803875e0*(lnTe**3)-0.56851189e0*(lnTe**4)+6.79539123e-2*(lnTe**5)-5.00905610e-3*(lnTe**6)+2.06723616e-4*(lnTe**7)-3.64916141e-6*(lnTe**8))

He+ + e- -> He              [10, 9.28e3]   3.92e-13*invTe**0.6353e0

He+ + e- -> He              [9.28e3, 1e8]  1.54e-9*(1.e0+0.3e0/exp(8.099328789667e0*invTe))/(exp(40.49664394833662e0*invTe)*Te**1.5e0)+3.92e-13/Te**0.6353e0

He+ + e- -> He++ + e- + e-  [9.28e3, 1e8]  exp(-68.71040990212001e0+43.93347632635e0*lnTe-18.48066993568e0*lnTe**2+4.701626486759002e0*lnTe**3-0.7692466334492e0*lnTe**4+0.08113042097303e0*lnTe**5-0.005324020628287001e0*lnTe**6+0.0001975705312221e0*lnTe**7-3.165581065665e-6*lnTe**8)

He++ + e- -> He+            [10, 1e8]      3.36e-10/sqrTgas/(Tgas/1.e3)**0.2e0/(1+(Tgas/1.e6)**0.7e0)

H + e- -> H-                [10, 1e8]      6.77e-15*Te**0.8779e0

H- + H -> H2 + e-           [10, 1160]     1.43e-9

H- + H -> H2 + e-           [1160, 1e8]    exp(-20.06913897587003e0+0.2289800603272916e0*lnTe+0.03599837721023835e0*lnTe**2-0.004555120027032095e0*lnTe**3-0.0003105115447124016e0*lnTe**4+0.0001073294010367247e0*lnTe**5-8.36671960467864e-6*lnTe**6+2.238306228891639e-7*lnTe**7)

H + H+ -> H2+               [10, 6.7e3]    1.85e-23*Tgas**1.8e0

H + H+ -> H2+               [6.7e3, 1e8]   5.81e-16*(Tgas/5.62e4)**(-0.6657e0*log10(Tgas/5.62e4))

H2+ + H -> H2 + H+          [10, 1e8]      6.0e-10

H2 + H+ -> H2+ + H          [3.48e3, 1e8]  exp(-24.24914687731536e0+3.400824447095291e0*lnTe-3.898003964650152e0*lnTe**2+2.045587822403071e0*lnTe**3-0.5416182856220388e0*lnTe**4+0.0841077503763412e0*lnTe**5-0.007879026154483455e0*lnTe**6+0.0004138398421504563e0*lnTe**7-9.36345888928611e-6*lnTe**8)

H2 + e- -> H + H + e-       [3.48e3, 1e8]  5.6e-11*exp(-102124.e0*invT)*Tgas**0.5e0

H2 + H -> H + H + H         [3.48e3, 1e8]  1.0670825e-10*Te**2.012e0/(exp(4.463e0*invTe)*(1.e0+0.2472e0*Te)**3.512e0)

H- + e- -> H + e- + e-      [4.64e2, 1e8]  exp(-18.01849334273e0+2.360852208681e0*lnTe-0.2827443061704e0*lnTe**2+0.01623316639567e0*lnTe**3-0.03365012031362999e0*lnTe**4+0.01178329782711e0*lnTe**5-0.001656194699504e0*lnTe**6+0.0001068275202678e0*lnTe**7-2.631285809207e-6*lnTe**8)

H- + H -> H + H + e-        [10, 1.16e3]   2.56e-9*Te**1.78186e0

H- + H -> H + H + e-        [1.16e3, 1e8]  exp(-20.37260896533324e0+1.139449335841631e0*lnTe-0.1421013521554148e0*lnTe**2+0.00846445538663e0*lnTe**3-0.0014327641212992e0*lnTe**4+0.0002012250284791e0*lnTe**5+0.0000866396324309e0*lnTe**6-0.00002585009680264e0*lnTe**7+2.4555011970392e-6*lnTe**8-8.06838246118e-8*lnTe**9)

H- + H+ -> H + H            [10, 1e8]      6.5e-9/sqrt(Te)

H- + H+ -> H2+ + e-         [10, 1e8]      1.e-8*Tgas**(-0.4e0)

H2+ + e- -> H + H           [10, 6.17e2]   1.e-8

H2+ + e- -> H + H           [6.17e2, 1e8]  1.32e-6*Tgas**(-0.76e0)

H2+ + H- -> H + H2          [10, 1e8]      5.e-7*sqrt(1.e2*invT)

H+ + D -> H + D+            [10, 1e8]      1.0e-9 *exp(-4.1e1*invT)

H + D+ -> H+ + D            [10, 1e8]      1.0e-9

H2 + D+ -> HD + H+          [10, 1e8]      2.1e-9

HD + H+ -> H2 + D+          [10, 1e8]      1.0e-9 *exp(-4.57e2*invT)

H2 + D -> HD + H            [10, 1e8]      7.5e-11*exp(-3.82e3*invT)

HD + H -> H2 + D            [10, 1e8]      7.5e-11*exp(-4.24e3*invT)

D + H- -> HD + e-           [10, 1e8]      1.5e-9*(T32)**(-0.1e0)

H + H + H -> H2 + H         [10, 3e2]      1.3e-32*(T32)**(-0.38e0)

H + H + H -> H2 + H         [3e2, 1e8]     1.3e-32*(T32)**(-1.00e0)

H -> H+ + e-                []             photo(xsec=auto)

D -> D+ + e-                []             photo(xsec=auto)

He -> He+ + e-              []             photo(xsec=auto)

He+ -> He++ + e-            []             photo(xsec=auto)

H2 -> H2+ + e-              []             photo(xsec=9.56e-17*(E_eV/15.4e0)-9.4e-17, Emin=15.4e0, Emax=16.5e0)

H2 -> H2+ + e-              []             photo(xsec=2.16e-17*(E_eV/15.4e0)-1.48e-17, Emin=16.5e0, Emax=17.7e0)

H2 -> H2+ + e-              []             photo(xsec=1.51e-17*(E_eV/15.4e0)**(-2.71), Emin=17.7e0, Emax=3e1)

#Miyake+2010, ApJL, note: resonance at 11eV not included
H- -> H + e-                []             photo(xsec=2.11e-16*(E_eV-.755)**(1.5)*E_eV**(-3), Emin=0.755, Emax=1e3)


