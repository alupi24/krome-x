# # SiO nucleation reactions
# # Cluster growth reactions
# # cluster_growth_rate(index_of_monomer, cluster_size, temperature, sticking_coefficient)
SiO + SiO -> Si2O2                []             cluster_growth_rate(SiO, 1)

Si2O2 + SiO -> Si3O3              []             cluster_growth_rate(SiO, 2)

Si3O3 + SiO -> Si4O4              []             cluster_growth_rate(SiO, 3)

Si4O4 + SiO -> Si5O5              []             cluster_growth_rate(SiO, 4)

Si5O5 + SiO -> Si6O6              []             cluster_growth_rate(SiO, 5)

Si6O6 + SiO -> Si7O7              []             cluster_growth_rate(SiO, 6)

Si7O7 + SiO -> Si8O8              []             cluster_growth_rate(SiO, 7)

Si8O8 + SiO -> Si9O9              []             cluster_growth_rate(SiO, 8)


# Cluster destruction reactions
# Based on detailed balance
Si2O2 -> SiO + SiO                []             cluster_growth_rate(SiO, 1) * revKc_with_GFE([Si2O2], [SiO, SiO])

Si3O3 -> Si2O2 + SiO              []             cluster_growth_rate(SiO, 2) * revKc_with_GFE([Si3O3], [Si2O2, SiO])

Si4O4 -> Si3O3 + SiO              []             cluster_growth_rate(SiO, 3) * revKc_with_GFE([Si4O4], [Si3O3, SiO])

