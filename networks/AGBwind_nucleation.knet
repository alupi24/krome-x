# Dissociative recombination reactions
# PFD15
# Estimate base on review of dissociative electron recombination of
# Florescu-Mitchell & Mitchell 2006 (FMM06) (doi:10.1016/J.PHYSREP.2006.04.002)
# MgX+ + E -> Mg + X
MgO+ + e- -> Mg + O               []             3e-7 * (Tgas/200.)**(-0.5)

MgO2+ + e- -> Mg + O2             []             3e-7 * (Tgas/200.)**(-0.5)

MgN2+ + e- -> Mg + N2             []             3e-7 * (Tgas/200.)**(-0.5)

MgCO2+ + e- -> Mg + CO2           []             3e-7 * (Tgas/200.)**(-0.5)

MgH2O+ + e- -> Mg + H2O           []             3e-7 * (Tgas/200.)**(-0.5)

MgN2O+ + e- -> Mg + N2O           []             3e-7 * (Tgas/200.)**(-0.5)

# dissociation based on ion cluster notation in W+11
# MgY+(dot)X + E -> MgY + X
MgO4+ + e- -> MgO2 + O2           []             3e-7 * (Tgas/200.)**(-0.5)

MgC2O4+ + e- -> Mg + CO2 + CO2    []             3e-7 * (Tgas/200.)**(-0.5)

MgH4O2+ + e- -> Mg + H2O + H2O    []             3e-7 * (Tgas/200.)**(-0.5)

MgO2N2+ + e- -> MgO2 + N2         []             3e-7 * (Tgas/200.)**(-0.5)

MgCO4+ + e- -> MgO2 + CO2         []             3e-7 * (Tgas/200.)**(-0.5)

MgH2O3+ + e- -> MgO2 + H2O        []             3e-7 * (Tgas/200.)**(-0.5)

# Missing recombination
NO+ + e- -> O + N                 []             4.30e-7*(T32)**(-0.37)

O2+ + e- -> O + O                 []             1.95e-7*(T32)**(-0.70)

# Atkinson+2004 (doi:10.5194/acp-4-1461-2004)
O3 + O -> O2 + O2                 []             8e-12 * exp(-2060.*invT)

# Atkinson+2004 (doi:10.5194/acp-4-1461-2004)
O + O2 + O2 -> O3 + O2            []             6.0e-34*(Tgas/300.)**(-2.6)

# DeMore+1997 (https://jpldataeval.jpl.nasa.gov/pdf/Atmos97_Anotated.pdf)
H + O3 -> OH + O2                 []             1.4e-10*exp(470.*invT)

