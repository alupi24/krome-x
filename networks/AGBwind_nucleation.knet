Si7O7 -> Si6O6 + SiO              []             cluster_growth_rate(SiO, 6) * revKc_with_GFE([Si7O7], [Si6O6, SiO])

Si8O8 -> Si7O7 + SiO              []             cluster_growth_rate(SiO, 7) * revKc_with_GFE([Si8O8], [Si7O7, SiO])

Si9O9 -> Si8O8 + SiO              []             cluster_growth_rate(SiO, 8) * revKc_with_GFE([Si9O9], [Si8O8, SiO])


