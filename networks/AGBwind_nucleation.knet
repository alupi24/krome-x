# # Cluster growth reactions
# # cluster_growth_rate(index_of_monomer, cluster_size, temperature, sticking_coefficient)
MgO + MgO -> Mg2O2                []             cluster_growth_rate(MgO, 1)

Mg2O2 + MgO -> Mg3O3              []             cluster_growth_rate(MgO, 2)

Mg3O3 + MgO -> Mg4O4              []             cluster_growth_rate(MgO, 3)

Mg4O4 + MgO -> Mg5O5              []             cluster_growth_rate(MgO, 4)

Mg5O5 + MgO -> Mg6O6              []             cluster_growth_rate(MgO, 5)

Mg6O6 + MgO -> Mg7O7              []             cluster_growth_rate(MgO, 6)

Mg7O7 + MgO -> Mg8O8              []             cluster_growth_rate(MgO, 7)

Mg8O8 + MgO -> Mg9O9              []             cluster_growth_rate(MgO, 8)

Mg9O9 + MgO -> Mg10O10            []             cluster_growth_rate(MgO, 9)

# Cluster destruction reactions
# Based on detailed balance
Mg2O2 -> MgO + MgO                []             cluster_growth_rate(MgO, 1) * revKc_with_GFE([Mg2O2], [MgO, MgO])

Mg3O3 -> Mg2O2 + MgO              []             cluster_growth_rate(MgO, 2) * revKc_with_GFE([Mg3O3], [Mg2O2, MgO])

Mg4O4 -> Mg3O3 + MgO              []             cluster_growth_rate(MgO, 3) * revKc_with_GFE([Mg4O4], [Mg3O3, MgO])

Mg5O5 -> Mg4O4 + MgO              []             cluster_growth_rate(MgO, 4) * revKc_with_GFE([Mg5O5], [Mg4O4, MgO])

Mg6O6 -> Mg5O5 + MgO              []             cluster_growth_rate(MgO, 5) * revKc_with_GFE([Mg6O6], [Mg5O5, MgO])

Mg7O7 -> Mg6O6 + MgO              []             cluster_growth_rate(MgO, 6) * revKc_with_GFE([Mg7O7], [Mg6O6, MgO])

Mg8O8 -> Mg7O7 + MgO              []             cluster_growth_rate(MgO, 7) * revKc_with_GFE([Mg8O8], [Mg7O7, MgO])

Mg9O9 -> Mg8O8 + MgO              []             cluster_growth_rate(MgO, 8) * revKc_with_GFE([Mg9O9], [Mg8O8, MgO])

Mg10O10 -> Mg9O9 + MgO            []             cluster_growth_rate(MgO, 9) * revKc_with_GFE([Mg10O10], [Mg9O9, MgO])

