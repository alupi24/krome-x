# TIO reactions
# Campbell and McClean 1993 DOI: 10.1021/j100132a024
# Note:
# Only the reactions of Ti with NO and CO2 were found to depend on the argon buffer gas pressure.
# Termolecular rate constants at 300 K were determined to be 5.8e-31 cm^6 s-1
# and 3.5e-32 cm^6 s-1 for NO and CO2,respectively.
Ti + O2 -> TiO + O                [300, 600]     1.69e-10*exp(-11.6/(R * Tgas))

Ti + N2O -> TiO + N2              [300, 600]     1.74e-10*exp(-14.3/(R * Tgas))

Ti + NO -> TiO + N                [300, 600]     3.28e-11*exp(-3.62/(R * Tgas))

Ti + CO2 -> TiO + CO              [300, 600]     7.e-11*exp(-14.9/(R * Tgas))

Ti + SO2 -> TiO + SO              [300, 600]     1.7e-10*exp(-2.66/(R * Tgas))

# [legacy @storeonce_start dropped: handled outside the network file in KROME-X]
Ti + NO2 -> TiO + NO              [300, 500]     9e-11
# [legacy @storeonce_stop dropped: handled outside the network file in KROME-X]

#reverse
TiO + O -> Ti + O2                [300, 600]     1.69e-10*exp(-11.6/(R * Tgas))*revKc_with_GFE([TiO, O], [Ti, O2])

TiO + N2 -> Ti + N2O              [300, 600]     1.74e-10*exp(-14.3/(R * Tgas))*revKc_with_GFE([TiO, N2], [Ti, N2O])

TiO + N -> Ti + NO                [300, 600]     3.28e-11*exp(-3.62/(R * Tgas))*revKc_with_GFE([TiO, N], [Ti, NO])

TiO + CO -> Ti + CO2              [300, 600]     7.e-11*exp(-14.9/(R * Tgas))*revKc_with_GFE([TiO, CO], [Ti, CO2])

TiO + SO -> Ti + SO2              [300, 600]     1.7e-10*exp(-2.66/(R * Tgas))*revKc_with_GFE([TiO, SO], [Ti, SO2])

TiO + NO -> Ti + NO2              [300, 500]     9e-11*revKc_with_GFE([TiO, NO], [Ti, NO2])

# Higuchi+2008 DOI: 10.1016/j.cplett.2007.12.067
# [legacy @storeonce_start dropped: handled outside the network file in KROME-X]
TiO + O2 -> TiO2 + O              [300, 300]     7.07e-12
# [legacy @storeonce_stop dropped: handled outside the network file in KROME-X]
# Note: products are unsure...

#reverse
TiO2 + O -> TiO + O2              [300, 300]     7.07e-12*revKc_with_GFE([TiO2, O], [TiO, O2])

#Ritter and Weisshaar 1989 DOI: 10.1021/j100341a076
# [legacy @storeonce_start dropped: handled outside the network file in KROME-X]
TiO + NO -> TiO2 + N              [300, 300]     2.2e-12
# [legacy @storeonce_stop dropped: handled outside the network file in KROME-X]
# Note: products are unsure...

#reverse
TiO2 + N -> TiO + NO              [300, 300]     2.2e-12*revKc_with_GFE([TiO2, N], [TiO, NO])

# Plane 2013 DOI: 10.1098/rsta.2012.0335
TiO + OH -> TiO2 + H              []             1.4e-11*(1000./Tgas)**0.39

TiO2 + H -> TiO + OH              []             5.0e-10*exp(-15570/Tgas)

