krome_format 1
# converted from legacy network 'react_star' by convert_legacy.py

## Small thermonuclear network for stars, mainly from NACRE99
## Note that qeff and curly species are used.
# [legacy reactionModifier converted into rate_scale:]
#   k(:) = k(:) / N_avogadro
rate_scale = 1 / N_avogadro


var T = Tgas
var T9 = T * 1.0e-9
var T92 = T9 * T9
var T93 = T92 * T9
var T94 = T92 * T92
var T95 = T93 * T92
var T96 = T93 * T93
var T913 = T9**0.3333
var T923 = T913 * T913
var T943 = T923 * T923
var T912 = sqrt(T9)
var T932 = T9 * T912

# NACRE99 (R1)
H + H + {H} -> 3He            [1.e0, 5.0e9]   (4.08e-15 / T923) * exp(-3.381 / T913) * (1.0 + 3.82 * T9 + 1.51 * T92 + 0.144 * T93 - 1.14e-2 * T94)  ; qeff=(1.442e0 - 0.2668e0 + 5.493e0)

# NACRE99 (R2)
H + 2H -> 3He                 [1.0e0, 1.1e8]  (1.81e3 / T923) * exp(-3.721 / T913) * (1.0 + 14.3 * T9 - 90.5 * T92 + 395.0 * T93)  ; qeff=5.493e0

# NACRE99 (R2)
H + 2H -> 3He                 [1.1e8, 5.0e9]  (2.58e3 / T923) * exp(-3.721 / T913) * (1.0 + 3.96 * T9 + 0.116 * T92)  ; qeff=5.493e0

# NACRE99 (R3)
3He + 3He -> 4He + H + H      [1.0e0, 5.0e9]  (5.59e10 / T923) * exp(-12.277 / T913) * (1.0 - 0.135 * T9 + 2.54e-2 * T92 -1.29e-3 * T93)  ; qeff=12.859e0

# Cyburt & Davis 2008 + NACRE99 (R4)
3He + 4He + {H} -> 4He + 4He  [1.0e0, 5.0e9]  (exp(15.609867 - 12.82707707 / T913 - 2.0 * log(T9) / 3.0) * ((1.0 - 0.020478 * T923 + 0.211995 * T943) / (1.0 + 0.255059 * T923 + 0.338573 * T943)))  ; qeff=(1.587e0 + 0.862e0 - (0.862e0 + 0.3855e0)/2.0e0)

# NACRE99 (R6)
H + 7Li -> 4He + 4He          [1.0e0, 5.0e9]  (7.20e8 / T923)*exp(-8.473 / T913 - (T9 / 6.5)**2) * (1.0 + 1.05 * T9 - 0.653 * T92 + 0.185 * T93 - 2.12e-2 * T94 + 9.30e-4 * T95) + 9.85e6 * (T9**0.576) * exp(-10.415 / T9)  ; qeff=17.347e0

# NACRE99 (R21)
H + 6Li -> 3He + 4He          [1.0e0, 5.0e9]  (3.54e10 / T923) * exp(-8.415 / T913) * (1.0 - 0.137 * T9 + 2.41e-2 * T92 - 1.28e-3 * T93)  ; qeff=4.019e0

# NACRE99 (R24)
H + 9Be -> 6Li + 4He          [1.0e0, 5.0e9]  (2.11e11 / T923) * exp(-10.361 / T913 - (T9 / 0.4)**2) * (1.0 - 0.189 * T9 + 35.2 * T92) + (5.24e8 / T932) * exp(-3.446/T9) + (4.65e8 / (T9**0.293)) * exp(-4.396 / T9)  ; qeff=2.125e0

# NACRE99 (R23)
H + 9Be -> 2H + 4He + 4He     [1.0e0, 5.0e9]  (2.18e11 / T923) * exp(-10.361 / T913 - (T9 / 0.42)**2) * (1.0 - 0.427 * T9 + 34.055 * T92) + (6.24e8 / T932) * exp(-3.446 / T9) + (3.53e8 / (T9**0.205)) * exp(-3.889 / T9)  ; qeff=0.651e0

# NACRE99 (R27)
H + 11B -> 4He + 4He + 4He    [1.0e0, 2.0e9]  (2.68e12/T923)*exp(-12.097/T913) * (1.0 + 1.62*T9 - 1.31*T92 + 0.260*T93) + (2.12e6/T932) * exp(-1.724/T9)  ; qeff=8.682e0

# NACRE99 (R27)
H + 11B -> 4He + 4He + 4He    [2.0e9, 5.0e9]  (5.84e11/T923)*exp(-12.097/T913) * (-1.0 + 0.883*T9 + 0.012*T92)/(0.187 + (T923 - 1.47)**2)  ; qeff=8.682e0

# NACRE99 + NACRE99 (R8)
H + 12C + {H} -> 14N          [1.0e0, 5.0e9]  (2.0e7 / T923) * exp(-13.692 / T913 - (T9 / 0.46)**2 ) * ( 1.0 + 9.89 * T9 - 59.8 * T92 + 266.0 * T93) + (1.0e5 / T932) * exp(-4.913 / T9) + 4.24e5 / T932 * exp(-21.62 / T9)  ; qeff=(1.943e0 + 2.221e0 - 0.7063e0 + 7.551e0)

# Reaction rates NACRE99
var R10 = (3.12e7 / T923) * exp(-15.193 / T913 - (T9 / 0.486)**2) * (0.782 - 1.50 * T9 + 17.97 * T92 - 3.32 * T93) + (2.11e3 / T932) * exp(-2.998 / T9) + (8.42e2 * (T9**0.0682)) * exp(-4.891/T9)
var R11_1 = (1.12e12 / T923) * exp(-15.253 / T913 - (T9 / 0.28)**2) * (1.0 + 4.95 * T9 + 143.0 * T92) + (1.01e8 / T932) * exp(-3.643 / T9) + (1.19e9 / T932) * exp(-7.406 / T9)
var R11_2 = (4.17e7 * (T9**0.917)) * exp(-3.292 / T9)
var R12_1 = (1.08e9 / T923) * exp(-15.254 / T913 - (T9 / 0.34)**2) * (1.0 + 6.15 * T9 + 16.4 * T92) + (9.23e3 / T932) * exp(-3.597 / T9) + (3.27e6 / T932) * exp(-11.024 / T9)
var R12_2 = (3.54e4 * (T9**0.095)) * exp(-2.306 / T9)

# Imbriani et al. 2005 + NACRE99 (R48)
H + 14N + {H} -> 12C + 4He    [1.0e0, 2.5e9]  where(R11_1 + R12_1>0e0, R10 * R11_1 / (R11_1 + R12_1), 0.0)  ; qeff=(7.297e0 + 2.760e0 - 0.9964e0 + 4.966e0)
H + 14N + {H} -> 12C + 4He    [2.5e9, 3.5e9]  where(R11_2 + R12_1>0e0, R10 * R11_2 / (R11_2 + R12_1), 0.0)  ; qeff=(7.297e0 + 2.760e0 - 0.9964e0 + 4.966e0)
H + 14N + {H} -> 12C + 4He    [3.5e9, 5.0e9]  where(R11_2 + R12_2>0e0, R10 * R11_2 / (R11_2 + R12_2), 0.0)  ; qeff=(7.297e0 + 2.760e0 - 0.9964e0 + 4.966e0)

# Imbriani et al. 2005 + NACRE99 (R49)
H + 14N + {H} -> 16O          [1.0e0, 2.5e9]  where(R11_1 + R12_1>0e0, R10 * R12_1 / (R11_1 + R12_1), 0.0)  ; qeff=(7.297e0 + 2.760e0 - 0.9964e0 + 12.127e0)
H + 14N + {H} -> 16O          [2.5e9, 3.5e9]  where(R11_2 + R12_1>0e0, R10 * R12_1 / (R11_2 + R12_1), 0.0)  ; qeff=(7.297e0 + 2.760e0 - 0.9964e0 + 12.127e0)
H + 14N + {H} -> 16O          [3.5e9, 5.0e9]  where(R11_2 + R12_2>0e0, R10 * R12_2 / (R11_2 + R12_2), 0.0)  ; qeff=(7.297e0 + 2.760e0 - 0.9964e0 + 12.127e0)

# NACRE99 + NACRE99 (R13)
H + 16O + {H} -> 14N + 4He    [1.0e0, 5.0e9]  7.37e7 * exp(-16.696 / T913) / (T9**0.82)  ; qeff=(0.600e0 + 2.762e0 - 0.9977e0 + 1.192e0)
