krome_format 1
# converted from legacy network 'react_COthin_noSi_Guv' by convert_legacy.py

param AUV      = 0.0    # runtime parameter (legacy @common:user_AUV); set default!
param Av       = 0.0    # runtime parameter (legacy @common:user_Av); set default!
param FUV_scale = 0.0    # runtime parameter (legacy @common:user_FUV_scale); set default!
param bUV_C    = 0.0    # runtime parameter (legacy @common:user_bUV_C); set default!
param bUV_H    = 0.0    # runtime parameter (legacy @common:user_bUV_H); set default!
param bUV_He   = 0.0    # runtime parameter (legacy @common:user_bUV_He); set default!
param bUV_Hej  = 0.0    # runtime parameter (legacy @common:user_bUV_Hej); set default!
param bUV_O    = 0.0    # runtime parameter (legacy @common:user_bUV_O); set default!
param crate    = 0.0    # runtime parameter (legacy @common:user_crate); set default!

# legacy shortcut symbols, now ordinary vars:
var Te       = Tgas_eV
var lnTe     = log(Tgas_eV)
var invTe    = 1.0/Tgas_eV
var logT     = log10(Tgas)
var invT     = 1.0/Tgas
var invTgas  = 1.0/Tgas
var T32      = Tgas/300.0
var invT32   = 300.0/Tgas

# functions provided by runtime physics modules:
extern fHnOj
extern fselfH2
extern n_global

#######################
#This is a prototype network for CO formation
#######################
#rates for CO network similar to Glover+2010 MNRAS from there and other authors
# [legacy 'var Hnuclei' dropped: builtin in KROME-X]
# [legacy 'var ntot' dropped: builtin in KROME-X]

var Te = Tgas_eV
var invT = 1e0/Tgas
var lnTe = log(Te)
var T = Tgas

#Janev 1987
H + e- -> H+ + e- + e-      []                exp(-32.71396786e0+13.5365560e0*lnTe-5.73932875e0*(lnTe**2)+1.56315498e0*(lnTe**3)-0.28770560e0*(lnTe**4)+3.48255977e-2*(lnTe**5)-2.63197617e-3*(lnTe**6)+1.11954395e-4*(lnTe**7)-2.03914985e-6*(lnTe**8))

#Abel et al. 1997, fit by data from Ferland et al. 1992
H+ + e- -> H                [2.73e0, 5.5e3]   3.92e-13*invTe**0.6353e0
H+ + e- -> H                [5.5e3, 1e8]      exp(-28.61303380689232e0-0.7241125657826851e0*lnTe-0.02026044731984691e0*lnTe**2-0.002380861877349834e0*lnTe**3-0.0003212605213188796e0*lnTe**4-0.00001421502914054107e0*lnTe**5+4.989108920299513e-6*lnTe**6+5.755614137575758e-7*lnTe**7-1.856767039775261e-8*lnTe**8-3.071135243196595e-9*lnTe**9)

#Janev 1987
He + e- -> He+ + e- + e-    []                exp(-44.09864886e0+23.91596563e0*lnTe-10.7532302e0*(lnTe**2)+3.05803875e0*(lnTe**3)-0.56851189e0*(lnTe**4)+6.79539123e-2*(lnTe**5)-5.00905610e-3*(lnTe**6)+2.06723616e-4*(lnTe**7)-3.64916141e-6*(lnTe**8))

#Radiative+dielectronic from Cen 1992, Aldrovandi & Pequignot 1973
He+ + e- -> He              [2.73e0, 9.28e3]  3.92e-13*invTe**0.6353e0
He+ + e- -> He              [9.28e3, 1e8]     1.54e-9*(1.e0+0.3e0/exp(8.099328789667e0*invTe))/(exp(40.49664394833662e0*invTe)*Te**1.5e0)+3.92e-13/Te**0.6353e0

#Aladdin database 1989 (see Abel et al. 1997)
He+ + e- -> He++ + e- + e-  []                exp(-68.71040990212001e0+43.93347632635e0*lnTe-18.48066993568e0*lnTe**2+4.701626486759002e0*lnTe**3-0.7692466334492e0*lnTe**4+0.08113042097303e0*lnTe**5-0.005324020628287001e0*lnTe**6+0.0001975705312221e0*lnTe**7-3.165581065665e-6*lnTe**8)

#Yoshida 2006, ApJ-652
He+ + H -> He + H+          []                1.25e-15*(T32)**.25

# De Jong (1972)
He + H+ -> He+ + H          [0, 1e4]          1.26e-9*Tgas**(-.75)*exp(-1.275e5*invT)
He + H+ -> He+ + H          [1e4, inf]        4e-37*Tgas**4.74


var invTe = 1e0/Te
var logT = log10(Tgas)
var invsqrT = 1e0/sqrt(Tgas)
var kl11 = 1e1**(-27.029e0+3.801e0*logT-29487e0*invT)
var kh11 = 1e1**(-2.729e0-1.75e0*logT-23474e0*invT)
var ncr11 = 1e1**(5.0792e0*(1e0-1.23e-5*(Tgas-2e3)))
var ax11 = 1.e0/(1.e0+(Hnuclei/(ncr11+1e-40)))
# [legacy @noTabNext dropped: handled outside the network file in KROME-X]
H2 + He -> H + H + He       []                kh11**(1.-ax11)*kl11**ax11


#Glover+2011 ####XXXX#####
H2 + He+ -> He + H2+        []                7.2e-15

H2 + He+ -> He + H + H+     []                3.7e-14*exp(-35e0*invT)

#KIDA Harada+2010
H2 + He+ -> He+ + H + H     []                3e-11*sqrt(T32)*exp(-5.2e4*invT)

#Verner & Ferland 1996
He++ + e- -> He+            []                1.891e-10/(sqrt(Tgas/9.37)*(1.+sqrt(Tgas/9.37))**0.2476*(1.+sqrt(Tgas/2.774e6))**1.7524)

#De Jong (1972)
H + e- -> H-                []                1.4e-18*Tgas**0.928*exp(-Tgas/16200.)

# fit by Kreckel et al. 2010
var a1 = 1.3500e-09
var a2 = 9.8493e-02
var a3 = 3.2852e-01
var a4 = 5.5610e-01
var a5 = 2.7710e-07
var a6 = 2.1826e+00
var a7 = 6.1910e-03
var a8 = 1.0461e+00
var a9 = 8.9712e-11
var a10 = 3.0424e+00
var a11 = 3.2576e-14
var a12 = 3.7741e+00
H- + H -> H2 + e-           []                a1*(Tgas**a2+a3*Tgas**a4+a5*Tgas**a6)/(1.+a7*Tgas**a8+a9*Tgas**a10+a11*Tgas**a12)

# fit to Ramaker & Peek 1976, corrected by Coppola
H + H+ -> H2+               [0, 3e1]          2.10e-20*(Tgas/30.)**(-0.15)
H + H+ -> H2+               [3e1, inf]        10**(-18.20-3.194*log10(Tgas)+1.786*(log10(Tgas))**2-0.2072*(log10(Tgas))**3)

#Karpas 1979 ####XXXX###
H2+ + H -> H2 + H+          []                6e-10

#fit by Savin et al. 2004, see also Grassi et al. 2011, lower limits is extended below 100K
var asav0 = -1.9153214e2
var asav1 = 4.0129114e2
var asav2 = -3.7446991e2
var asav3 = 1.9078410e2
var asav4 = -5.7263467e1
var asav5 = 1.0133210e1
var asav6 = -9.8012853e-1
var asav7 = 4.0023414e-2
var bsav0 = -8.8755774e3
var bsav1 = 1.0081246e4
var bsav2 = -4.8606622e3
var bsav3 = 1.2889659e3
var bsav4 = -2.0319575e2
var bsav5 = 1.9057493e1
var bsav6 = -9.8530668e-1
var bsav7 = 2.1675387e-2
var sumsav = asav0+asav1*log10(Tgas)+asav2*(log10(Tgas))**2+asav3*(log10(Tgas))**3+asav4*(log10(Tgas))**4+asav5*(log10(Tgas))**5+asav6*(log10(Tgas))**6+asav7*(log10(Tgas))**7
var sumsbv = bsav0+bsav1*log10(Tgas)+bsav2*(log10(Tgas))**2+bsav3*(log10(Tgas))**3+bsav4*(log10(Tgas))**4+bsav5*(log10(Tgas))**5+bsav6*(log10(Tgas))**6+bsav7*(log10(Tgas))**7
H2 + H+ -> H2+ + H          [0, 1.e5]         10**sumsav
H2 + H+ -> H2+ + H          [1.e5, inf]       10**sumsbv

#fit by Mitchell & Deveau 1983 of data by Corrigan 1965
H2 + e- -> H + H + e-       []                4.38e-10*exp(-1.02e5*invT)*Tgas**(0.35)


#Lepp+Shull 1983, updated with Glover+2010
var kHdiss = 3.52e-9*exp(-4.39e4*invT) + 1e-40
var kLdiss = 6.67e-12*sqrt(Tgas)*exp(-(1e0+63590.*invT)) + 1e-40
var ncrdiss = 1e1**(3. - 0.416*log10(Tgas/1e4) - 0.327*log10(Tgas/1e4)**2)
H2 + H -> H + H + H         []                1e1**(log10(kHdiss)-log10(kHdiss/kLdiss)/(1e0+ntot/ncrdiss))


#Janev 1987
H- + e- -> H + e- + e-      []                exp(-18.01849334273e0+2.360852208681e0*lnTe-0.2827443061704e0*lnTe**2+0.01623316639567e0*lnTe**3-0.03365012031362999e0*lnTe**4+0.01178329782711e0*lnTe**5-0.001656194699504e0*lnTe**6+0.0001068275202678e0*lnTe**7-2.631285809207e-6*lnTe**8)

#Abel+1997, based on Janev 1987
H- + H -> H + H + e-        [0, 1.16e3]       2.56e-9*Te**1.78186
H- + H -> H + H + e-        [1.16e3, inf]     exp(-20.37260896533324e0+1.139449335841631e0*lnTe-0.1421013521554148e0*lnTe**2+0.00846445538663e0*lnTe**3-0.0014327641212992e0*lnTe**4+0.0002012250284791e0*lnTe**5+0.0000866396324309e0*lnTe**6-0.00002585009680264e0*lnTe**7+2.4555011970392e-6*lnTe**8-8.06838246118e-8*lnTe**9)

#Stenrup+2009, extended to higher temperature (extrapolation from xsecs, but new calculations are required)
H- + H+ -> H + H            []                (2.96e-6/sqrt(Tgas) - 1.73e-9 + 2.50e-10*sqrt(Tgas))

#Poulart 1978
H- + H+ -> H2+ + e-         []                1.e-8*Tgas**(-0.4)

#Abel et al. 1997, fit by data from Schneider 1994
H2+ + e- -> H + H           [0, 6.17e2]       1.e-8
H2+ + e- -> H + H           [6.17e2, inf]     1.32e-6*Tgas**(-0.76)

#Dalgarno+Lepp 1987
H2+ + H- -> H + H2          []                5e-7*sqrt(1e2*invT)

#Lepp+Shull 1983, updated with Glover+2010
var kHdissH2 = 1.3e-9*exp(-5.33e4*invT) + 1e-40
var kLdissH2 = 5.996e-30*Tgas**4.1881/(1.+6.761e-6*Tgas)**5.6881 * exp(-5.46574e4*invT) + 1e-40
var ncrdissH2 = 1e1**(4.845 - 1.3*log10(Tgas/1e4) + 1.62*log10(Tgas/1e4)**2)
H2 + H2 -> H2 + H + H       []                1e1**(log10(kHdissH2)-log10(kHdissH2/kLdissH2)/(1e0+ntot/ncrdissH2))

#Glover+2010
H + H + He -> H2 + He       []                6.9e-32*Tgas**(-.4)

#Forrey 2013
H + H + H -> H2 + H         []                6e-32*Tgas**(-.25) + 2e-31*Tgas**(-.5)

#Glover&Abel 2008
H2 + H + H -> H2 + H2       []                (6e-32*Tgas**(-0.25) + 2e-31*Tgas**(-.5)) / 8e0

