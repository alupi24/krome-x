O+ + e- -> O                [0, 4e2]          1.30e-10*(Tgas)**(-0.64)
O+ + e- -> O                [4e2, inf]        1.41e-10*(Tgas)**(-0.66) + 7.4e-4*(Tgas)**(-1.5)*exp(-1.75e5*invT)*(1e0 + 0.062e0*exp(-1.45e5*invT))

var u1 = 11.26e0*invTe
var u2 = 8.2e0*invTe
var u3 = 13.6*invTe
C + e- -> C+ + e- + e-      []                6.85e-8*u1**0.25*exp(-u1)/(0.193e0+u1)
O + e- -> O+ + e- + e-      []                3.59e-8*u3**0.34*exp(-u3)/(0.073e0+u3)

