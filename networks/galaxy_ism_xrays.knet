O+++++ + He -> O++++ + He+      []                0.54e-9*5e0


var sqrtT32 = sqrt(Tgas/3e2)
var invsqrT32 = 1e0/sqrt(Tgas/3e2)

C+ + Fe -> Fe+ + C              []                2.60e-09
H+ + Fe -> Fe+ + H              []                7.40e-09
