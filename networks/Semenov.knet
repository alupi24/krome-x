ebind HCP = 1e99, 1e99
ebind HCSi = 1e99, 1e99
ebind HCl = 1e99, 1e99
ebind HNSi = 1e99, 1e99
ebind HPO = 1e99, 1e99
ebind N2O = 1e99, 1e99
ebind NH2CN = 1e99, 1e99
ebind NO2 = 1e99, 1e99
ebind P = 1e99, 1e99
ebind PH = 1e99, 1e99
ebind PH2 = 1e99, 1e99
ebind PN = 1e99, 1e99
ebind PO = 1e99, 1e99
ebind SiC2 = 1e99, 1e99
ebind SiC2H = 1e99, 1e99
ebind SiC2H2 = 1e99, 1e99
