krome_format 1
# converted from legacy network 'react_Semenov' by convert_legacy.py

# 621 legacy Semenov grain-surface rates are KROME-X surface reactions:
# generate with surface.binding_energies = "SEMENOV" and surface.cr_desorption = the CR-rate parameter
# the legacy Semenov framework's grains: one size
surface_grains single(n = xdust, a2 = gsize2)
# no binding energy in Ebare_ice_Semenov.dat for these ices: inert as in legacy
# (1e99 K: they never desorb or diffuse)
ebind C2H6CO = 1e99, 1e99
ebind C3P = 1e99, 1e99
ebind C4P = 1e99, 1e99
ebind CCP = 1e99, 1e99
ebind CCl = 1e99, 1e99
ebind CH2PH = 1e99, 1e99
