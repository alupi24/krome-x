krome_format 1
# converted from legacy network 'react_primordialZ_UV' by convert_legacy.py

param redshift = 0.0    # runtime parameter (legacy @common:user_redshift); set default!

# legacy shortcut symbols, now ordinary vars:
var lnTe     = log(Tgas_eV)
var invTe    = 1.0/Tgas_eV
var logT     = log10(Tgas)
var invT     = 1.0/Tgas
var sqrTgas  = sqrt(Tgas)
var invsqrT  = 1.0/sqrt(Tgas)
var T32      = Tgas/300.0
var invsqrT32 = sqrt(300.0/Tgas)

# functions provided by runtime physics modules:
extern sigma_v96

#############
#primordial chemistry including carbon and oxygen chemistry from Omukai et al. 2005

#primordial rates from Omukai+2000

var T = Tgas
var invT = 1e0/Tgas
var invsqrT = 1e0/sqrt(Tgas)

