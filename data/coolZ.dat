#SILICON I (2.0.0)
# block generated by tools/maintainer/tables/gen_coolz_ions.py
# levels, e: CHIANTI 11.0.2 si_1 (data/cooling/sources/chianti/);
# A: NIST ASD (data/cooling/sources/nist_asd_Si_I.txt)
metal:Si
#level n: energy (K), degeneracy g
level 0: 0.000000, 1
level 1: 110.951279, 3
level 2: 321.073132, 5

#Aij
1 -> 0, 8.2500e-06
2 -> 0, 3.4900e-10
2 -> 1, 4.2100e-05

# e: Dufresne, Del Zanna & Storey 2021 (MNRAS 505, 3968) via CHIANTI, log10 q on 10-1e5 K
e, 1, 0, 1d1**fspline((/1.000000d0, 1.250000d0, 1.500000d0, 1.750000d0, 2.000000d0, 2.250000d0, 2.500000d0, 2.750000d0, 3.000000d0, 3.250000d0, 3.500000d0, 3.750000d0, 4.000000d0, 4.250000d0, 4.500000d0, 4.750000d0, 5.000000d0/), (/-7.214218d0, -7.338448d0, -7.462082d0, -7.584660d0, -7.705370d0, -7.822732d0, -7.933837d0, -8.031757d0, -8.095654d0, -8.087523d0, -8.077599d0, -8.111182d0, -8.113108d0, -8.095876d0, -8.066944d0, -8.061132d0, -8.118430d0/), logTgas)
e, 2, 0, 1d1**fspline((/1.000000d0, 1.250000d0, 1.500000d0, 1.750000d0, 2.000000d0, 2.250000d0, 2.500000d0, 2.750000d0, 3.000000d0, 3.250000d0, 3.500000d0, 3.750000d0, 4.000000d0, 4.250000d0, 4.500000d0, 4.750000d0, 5.000000d0/), (/-7.410496d0, -7.534716d0, -7.658333d0, -7.780882d0, -7.901537d0, -8.018804d0, -8.129733d0, -8.227294d0, -8.290328d0, -8.280462d0, -8.269407d0, -8.302451d0, -8.303731d0, -8.294557d0, -8.292971d0, -8.311844d0, -8.357766d0/), logTgas)
e, 2, 1, 1d1**fspline((/1.000000d0, 1.250000d0, 1.500000d0, 1.750000d0, 2.000000d0, 2.250000d0, 2.500000d0, 2.750000d0, 3.000000d0, 3.250000d0, 3.500000d0, 3.750000d0, 4.000000d0, 4.250000d0, 4.500000d0, 4.750000d0, 5.000000d0/), (/-6.852979d0, -6.977251d0, -7.100960d0, -7.223671d0, -7.344612d0, -7.462370d0, -7.574131d0, -7.673028d0, -7.737920d0, -7.729787d0, -7.720548d0, -7.757235d0, -7.763080d0, -7.751632d0, -7.742625d0, -7.756475d0, -7.808156d0/), logTgas)

# H: Yan & Babb 2023 (MNRAS 522, 1265; arXiv:2304.02727), Table 1, 10-1e4 K (was HM89)
H, 1, 0, fspline((/10.0d0, 20.0d0, 50.0d0, 70.0d0, 100.0d0, 200.0d0, 500.0d0, 700.0d0, 1000.0d0, 2000.0d0, 5000.0d0, 7000.0d0, 10000.0d0/), (/0.238d-9, 0.247d-9, 0.255d-9, 0.265d-9, 0.280d-9, 0.322d-9, 0.381d-9, 0.405d-9, 0.433d-9, 0.505d-9, 0.636d-9, 0.705d-9, 0.800d-9/), Tgas)
H, 2, 0, fspline((/10.0d0, 20.0d0, 50.0d0, 70.0d0, 100.0d0, 200.0d0, 500.0d0, 700.0d0, 1000.0d0, 2000.0d0, 5000.0d0, 7000.0d0, 10000.0d0/), (/0.043d-9, 0.044d-9, 0.058d-9, 0.069d-9, 0.084d-9, 0.120d-9, 0.186d-9, 0.219d-9, 0.259d-9, 0.353d-9, 0.510d-9, 0.584d-9, 0.675d-9/), Tgas)
H, 2, 1, fspline((/10.0d0, 20.0d0, 50.0d0, 70.0d0, 100.0d0, 200.0d0, 500.0d0, 700.0d0, 1000.0d0, 2000.0d0, 5000.0d0, 7000.0d0, 10000.0d0/), (/0.248d-9, 0.272d-9, 0.319d-9, 0.342d-9, 0.370d-9, 0.443d-9, 0.598d-9, 0.682d-9, 0.788d-9, 1.052d-9, 1.526d-9, 1.754d-9, 2.036d-9/), Tgas)

# H+: Hollenbach & McKee 1989, as before
H+, 1, 0, 7.2d-9
H+, 2, 0, 7.2d-9
H+, 2, 1, 2.2d-8

endmetal

