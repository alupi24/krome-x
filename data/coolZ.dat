#IRON I
metal:Fe
#level n: energy (K), degeneracy g
level 0: 0.e0, 9
level 1: 598.43e0, 7
level 2: 1012.9e0, 5
level 3: 9968.2e0, 11
level 4: 10613.5e0, 9

#Aij
1 -> 0, 2.5d-3
2 -> 0, 1.d-9
2 -> 1, 1.6d-3
3 -> 0, 2.d-3
4 -> 0, 1.5d-3
4 -> 3, 3.6d-3

H, 1, 0, 8.D-10*(T2)**(.17)
H, 2, 0, 6.9D-10*(T2)**(.17)
H, 2, 1, 5.3D-10*(T2)**(.17)

e, 1, 0, 1.2D-7
e, 2, 0, 1.2D-7
e, 2, 1, 9.3D-8
e, 3, 0, 2.D-7*(Tgas/1.d4)**(.57)
e, 4, 0, 1.D-7*(Tgas/1.d4)**(.57)
e, 4, 3, 1.5D-7

endmetal

