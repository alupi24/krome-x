#cooling function for several species (especially metals)
# 2.0.0: C, C+ and O from current collision data (LAMDA; see each block
# and docs/devlog.md), Si + H and the new S I from Yan & Babb 2023; O+,
# Si+, Si, Fe+ levels and electron rates from CHIANTI 11.0.2, A-values
# from the NIST ASD, Si+ + H from Barinovs et al. 2005 (those blocks by
# tools/maintainer/tables/gen_coolz_ions.py); Fe as before (Maio et al. 2007, mostly
# Hollenbach & McKee 1989). A 16-level Fe+: data/cooling/coolFeII_16.dat

#define here shortcut variables employed in excitation rates
@var:T2 = Tgas*1d-2
@var:invTgas = 1d0/Tgas
@var:lnT = log(Tgas)

@TgasUpperLimit:1d4

##############
#CARBON
# from LAMDA catom.dat (data/cooling/sources/) by kromex_convert/lamda2krome.py; H: Yan & Babb 2023
metal:C
# level n: energy (K), degeneracy g
level 0: 0.0, 1.0
level 1: 23.61998595252738, 3.0
level 2: 62.46227436329141, 5.0
# up -> low, Aij (1/s)
1 -> 0, 7.880E-08
2 -> 1, 2.650E-07
2 -> 0, 1.810E-14
# collider H: Yan & Babb 2023 (MNRAS 518, 6004; arXiv:2211.13103), Table 1, 10-1e4 K (LAMDA: Launay & Roueff 1977, 10-200 K)
H, 1, 0, fspline((/10.0d0, 20.0d0, 50.0d0, 70.0d0, 100.0d0, 200.0d0, 500.0d0, 700.0d0, 1000.0d0, 2000.0d0, 5000.0d0, 7000.0d0, 10000.0d0/), (/0.199d-9, 0.182d-9, 0.157d-9, 0.153d-9, 0.152d-9, 0.159d-9, 0.189d-9, 0.205d-9, 0.227d-9, 0.284d-9, 0.400d-9, 0.458d-9, 0.527d-9/), Tgas)
H, 2, 0, fspline((/10.0d0, 20.0d0, 50.0d0, 70.0d0, 100.0d0, 200.0d0, 500.0d0, 700.0d0, 1000.0d0, 2000.0d0, 5000.0d0, 7000.0d0, 10000.0d0/), (/0.086d-9, 0.080d-9, 0.077d-9, 0.081d-9, 0.088d-9, 0.110d-9, 0.149d-9, 0.167d-9, 0.189d-9, 0.245d-9, 0.346d-9, 0.393d-9, 0.451d-9/), Tgas)
H, 2, 1, fspline((/10.0d0, 20.0d0, 50.0d0, 70.0d0, 100.0d0, 200.0d0, 500.0d0, 700.0d0, 1000.0d0, 2000.0d0, 5000.0d0, 7000.0d0, 10000.0d0/), (/0.252d-9, 0.251d-9, 0.256d-9, 0.265d-9, 0.283d-9, 0.339d-9, 0.450d-9, 0.504d-9, 0.572d-9, 0.743d-9, 1.061d-9, 1.213d-9, 1.397d-9/), Tgas)
# collider, level_up, level_down, de-excitation rate (cm^3/s), LAMDA partner 4
e, 1, 0, fspline((/10.0d0, 20.0d0, 50.0d0, 100.0d0, 200.0d0, 500.0d0, 1000.0d0, 10000.0d0, 20000.0d0/), (/8.1d-11, 9.8d-11, 1.7d-10, 2.8d-10, 5.2d-10, 1.2d-09, 2.0d-09, 1.1d-08, 1.2d-08/), Tgas)
e, 2, 0, fspline((/10.0d0, 20.0d0, 50.0d0, 100.0d0, 200.0d0, 500.0d0, 1000.0d0, 10000.0d0, 20000.0d0/), (/1.5d-10, 1.6d-10, 1.9d-10, 2.3d-10, 2.9d-10, 4.8d-10, 9.2d-10, 4.3d-09, 4.8d-09/), Tgas)
e, 2, 1, fspline((/10.0d0, 20.0d0, 50.0d0, 100.0d0, 200.0d0, 500.0d0, 1000.0d0, 10000.0d0, 20000.0d0/), (/3.7d-10, 4.0d-10, 5.2d-10, 7.0d-10, 1.0d-09, 1.9d-09, 3.5d-09, 1.8d-08, 2.0d-08/), Tgas)
# collider, level_up, level_down, de-excitation rate (cm^3/s), LAMDA partner 7
H+, 1, 0, fspline((/100.0d0, 200.0d0, 500.0d0, 1000.d0, 2000.d0/), (/7.6d-10, 1.0d-09, 1.4d-09, 1.8d-09, 2.1d-09/), Tgas)
H+, 2, 0, fspline((/100.0d0, 200.0d0, 500.0d0, 1000.d0, 2000.d0/), (/3.0d-10, 5.5d-10, 1.5d-09, 2.6d-09, 3.9d-09/), Tgas)
H+, 2, 1, fspline((/100.0d0, 200.0d0, 500.0d0, 1000.d0, 2000.d0/), (/2.3d-09, 3.9d-09, 7.8d-09, 1.1d-08, 1.3d-08/), Tgas)
# collider, level_up, level_down, de-excitation rate (cm^3/s), LAMDA partner 6
He, 1, 0, fspline((/10.0d0, 20.0d0, 40.0d0, 100.0d0, 150.0d0/), (/8.49d-12, 1.35d-11, 1.59d-11, 1.74d-11, 1.86d-11/), Tgas)
He, 2, 0, fspline((/10.0d0, 20.0d0, 40.0d0, 100.0d0, 150.0d0/), (/4.05d-11, 4.23d-11, 4.34d-11, 4.42d-11, 4.53d-11/), Tgas)
He, 2, 1, fspline((/10.0d0, 20.0d0, 40.0d0, 100.0d0, 150.0d0/), (/7.15d-11, 7.48d-11, 7.75d-11, 8.29d-11, 8.83d-11/), Tgas)
# collider, level_up, level_down, de-excitation rate (cm^3/s), LAMDA partner 2
ortho/para: 3/1
H2pa, 1, 0, fspline((/10.0d0, 20.0d0, 50.0d0, 100.0d0, 200.0d0, 500.0d0, 1000.0d0, 1200.0d0/), (/9.6d-11, 1.0d-10, 7.7d-11, 6.7d-11, 6.7d-11, 7.6d-11, 8.1d-11, 8.0d-11/), Tgas)
H2pa, 2, 0, fspline((/10.0d0, 20.0d0, 50.0d0, 100.0d0, 200.0d0, 500.0d0, 1000.0d0, 1200.0d0/), (/9.6d-11, 9.9d-11, 9.2d-11, 8.6d-11, 8.5d-11, 9.6d-11, 1.0d-10, 1.0d-10/), Tgas)
H2pa, 2, 1, fspline((/10.0d0, 20.0d0, 50.0d0, 100.0d0, 200.0d0, 500.0d0, 1000.0d0, 1200.0d0/), (/1.8d-10, 1.8d-10, 1.8d-10, 1.8d-10, 1.9d-10, 2.3d-10, 2.6d-10, 2.6d-10/), Tgas)
# collider, level_up, level_down, de-excitation rate (cm^3/s), LAMDA partner 3
ortho/para: 3/1
H2or, 1, 0, fspline((/10.0d0, 20.0d0, 50.0d0, 100.0d0, 200.0d0, 500.0d0, 1000.0d0, 1200.0d0/), (/7.3d-11, 8.1d-11, 7.6d-11, 7.1d-11, 7.1d-11, 8.0d-11, 8.6d-11, 8.5d-11/), Tgas)
H2or, 2, 0, fspline((/10.0d0, 20.0d0, 50.0d0, 100.0d0, 200.0d0, 500.0d0, 1000.0d0, 1200.0d0/), (/5.2d-11, 5.8d-11, 6.3d-11, 6.9d-11, 7.9d-11, 1.0d-10, 1.1d-10, 1.1d-10/), Tgas)
H2or, 2, 1, fspline((/10.0d0, 20.0d0, 50.0d0, 100.0d0, 200.0d0, 500.0d0, 1000.0d0, 1200.0d0/), (/9.2d-11, 1.1d-10, 1.3d-10, 1.5d-10, 1.8d-10, 2.5d-10, 2.8d-10, 2.8d-10/), Tgas)
endmetal

